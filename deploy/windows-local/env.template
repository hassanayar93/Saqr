# ═══ صقر SAQR — Demo متكامل (Binance Testnet حقيقي + Telegram + لوحة) ═══
# 1) انسخ هذا الملف إلى .env  2) عبّئ Telegram  3) START_SAQR.bat

SAQR_MODE=demo
SAQR_REQUIRE_INTEGRATED_DEMO=true
SAQR_ENABLE_TRADING=false
SAQR_INITIAL_BALANCE_USD=500
SAQR_SYMBOL=BTCUSDT

# باينانس Testnet — بيانات حية (WS + أسعار). المفاتiح اختيارية في demo للأسعار العامة.
BINANCE_TESTNET=true
BINANCE_REST_URL=https://testnet.binance.vision
BINANCE_WS_URL=wss://testnet.binance.vision
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_RECV_WINDOW=5000

# تيليجرام — مطلوب للتكامل (رسائل حالة + ربط اللوحة)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_SECONDARY_BOT_TOKEN=

SAQR_WEB_BIND_HOST=127.0.0.1
SAQR_WEB_BIND_PORT=8787
SAQR_INTEGRATION_INTERVAL_SECS=300

RUST_LOG=info
