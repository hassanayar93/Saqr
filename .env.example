# صقر — Binance (Demo/Testnet افتراضياً)
SAQR_MODE=demo
# demo | testnet | live  (live يتطلب تفعيلاً صريحاً في الإعدادات)

BINANCE_API_KEY=
BINANCE_API_SECRET=

# Testnet (اختياري): https://testnet.binance.vision/
BINANCE_TESTNET=true

# رموز افتراضية
SAQR_SYMBOL=BTCUSDT
SAQR_QUOTE_ASSET=USDT

# إدارة مخاطر (افتراضيات آمنة)
SAQR_MAX_ORDER_USDT=50
SAQR_LOOP_INTERVAL_SEC=30

LOG_LEVEL=INFO
